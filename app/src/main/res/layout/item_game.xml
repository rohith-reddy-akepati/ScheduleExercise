<?xml version="1.0" encoding="utf-8"?>
<!--
    One schedule row for a Type "S" (scheduled) or "F" (final) game.

    Spec mapping:
      1. Score text size 32dp            -> teamScoreOrRecordText / opponentScoreOrRecordText,
                                             applied programmatically only for Final games
                                             (see ScheduleAdapter) since Scheduled games show
                                             a "0-0" record here instead of a score.
      2. Team Name text size 24sp        -> teamNameText / opponentNameText
      3. Team Logo size 20x20dp          -> teamLogo / opponentLogo
      5. Score container min height 200dp -> scoreRow
      7. All other text 14sp             -> everything else in this file
      8. Grey #808080 / Black #000000    -> @color/spec_grey / @color/spec_black
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:minHeight="@dimen/score_container_min_height"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_md"
    android:paddingEnd="@dimen/spacing_md"
    android:paddingTop="@dimen/spacing_sm">

    <!-- Team names -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/teamNameText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start"
            android:textColor="@color/spec_black"
            android:textSize="@dimen/text_team_name"
            android:textStyle="bold"
            tools:text="EAGLES" />

        <TextView
            android:id="@+id/opponentNameText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="@color/spec_black"
            android:textSize="@dimen/text_team_name"
            android:textStyle="bold"
            tools:text="FALCONS" />
    </LinearLayout>

    <!-- Records / scores + logos. Takes the slack in the 200dp-minimum cell (spec item 5,
         enforced on the cell root above) so the scores sit optically centred between the
         team names and the date row, rather than the cell padding out below the content. -->
    <LinearLayout
        android:id="@+id/scoreRow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/teamScoreOrRecordText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end|center_vertical"
            android:textColor="@color/spec_black"
            android:textSize="@dimen/text_default"
            tools:text="0-0" />

        <ImageView
            android:id="@+id/teamLogo"
            android:layout_width="@dimen/logo_size"
            android:layout_height="@dimen/logo_size"
            android:layout_marginStart="@dimen/spacing_sm"
            android:contentDescription="@null"
            android:scaleType="centerInside"
            tools:src="@drawable/ic_logo_placeholder" />

        <TextView
            android:id="@+id/vsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:textColor="@color/spec_grey"
            android:textSize="@dimen/text_default"
            tools:text="@" />

        <ImageView
            android:id="@+id/opponentLogo"
            android:layout_width="@dimen/logo_size"
            android:layout_height="@dimen/logo_size"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:contentDescription="@null"
            android:scaleType="centerInside"
            tools:src="@drawable/ic_logo_placeholder" />

        <TextView
            android:id="@+id/opponentScoreOrRecordText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:textColor="@color/spec_black"
            android:textSize="@dimen/text_default"
            tools:text="0-0" />
    </LinearLayout>

    <!-- Date / week / time-or-final-state. rightLabelText is gravity="end", which - since
         this is the bottom-most text row of the card - is what satisfies "Final type games
         should display the gamestate in the lower-right corner." -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Date and the right-hand label are wrap_content so they can never be
             truncated; the week label takes whatever space is left. The feed puts long
             values in there ("Divisional Playoffs", not just "Week 1"), which would wrap
             awkwardly if all three columns were forced to an equal third. -->
        <TextView
            android:id="@+id/dateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:textColor="@color/spec_black"
            android:textSize="@dimen/text_default"
            tools:text="Mon, Sep 14" />

        <TextView
            android:id="@+id/weekLabelText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/spec_grey"
            android:textSize="@dimen/text_default"
            tools:text="Week 1" />

        <TextView
            android:id="@+id/rightLabelText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="@color/spec_black"
            android:textSize="@dimen/text_default"
            android:textStyle="bold"
            tools:text="7:10 PM" />
    </LinearLayout>

    <!-- Network, e.g. "ESPN". Hidden entirely when the feed doesn't supply one. -->
    <TextView
        android:id="@+id/networkText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:gravity="center"
        android:textColor="@color/spec_grey"
        android:textSize="@dimen/text_default"
        android:visibility="gone"
        tools:text="ESPN"
        tools:visibility="visible" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/spacing_sm"
        android:background="@color/divider" />

</LinearLayout>
