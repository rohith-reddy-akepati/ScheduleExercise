<?xml version="1.0" encoding="utf-8"?>
<!--
    Spec item 6: "Regular Season container: 60dp, text size of 20sp."
    Fixed-height (not min-height) section divider, e.g. "REGULAR SEASON" / "PRESEASON".
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/section_header_height"
    android:background="@color/section_header_bg">

    <TextView
        android:id="@+id/sectionHeaderText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:letterSpacing="0.03"
        android:textColor="@color/spec_black"
        android:textSize="@dimen/text_section_header"
        android:textStyle="bold"
        tools:text="2020 REGULAR SEASON" />

</FrameLayout>
